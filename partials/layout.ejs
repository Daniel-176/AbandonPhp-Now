<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= typeof title !== 'undefined' ? title : 'Home' %></title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: #e3e3e3;
            color: #343434;
            font: 16px 'Helvetica Neue', Arial, sans-serif;
        }

        .site-header {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: 40px;
            background: #232527;
            box-shadow: 0 2px 6px rgba(0,0,0,.35);
            z-index: 1000;
        }

        #navigation-container {
            display: flex;
            align-items: center;
            height: 100%;
            width: 970px;
            max-width: 100%;
            margin: 0 auto;
        }

        #navigation-menu ul { list-style: none; margin: 0; padding: 0; }
        #navigation-menu a {
        display: block;
        padding: 0 16px;
        line-height: 40px;
        color: #fff;
        font-weight: bold;
        text-decoration: none;
        }
        #navigation-menu a:hover { background: #393b3d; }

        #Body {
            max-width: 100%;
            min-height: 400px;
            padding: 24px 28px;
            background: #fff;
            border: 1px solid #c3c3c3;
            margin: 20px 0;
            border-radius: 3px;
        }
    </style>
</head>
<body>
    <%- include('header') %>
    <div class="forceSpace">&nbsp;</div>
    <noscript>
        <div class="SystemAlert">
            <div class="SystemAlertText">Please enable Javascript to use all the features on this site.</div>
        </div>
    </noscript>
    <div id="BodyWrapper">
        <div id="RepositionBody">
            <div id="Body" style="width:970px">
                <%- body %>
            </div>
        </div>
    </div>
    <%- include('footer') %>
</body>
</html>